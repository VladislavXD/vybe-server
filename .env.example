# Database Connection (PostgreSQL >= 15)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# =============================================================================
# Option A: Local Development with MinIO (Default)
# =============================================================================
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ROOT_USER="trackup"
MINIO_ROOT_PASSWORD="your-strong-password"
MINIO_BUCKET_NAME="trackup-storage"
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_REGION="us-east-1"

# =============================================================================
# Option B: Cloudflare R2 (Production)
# =============================================================================
# R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID="<R2_ACCESS_KEY_ID>"
# R2_SECRET_ACCESS_KEY="<R2_SECRET_ACCESS_KEY>"
# R2_BUCKET_NAME="trackup-storage"
# R2_PUBLIC_URL="https://cdn.trackup.uz" # or https://pub-<hash>.r2.dev
# R2_REGION="auto"
# STORAGE_INCLUDE_BUCKET_IN_URL=false # false for R2 Custom Domains / r2.dev
